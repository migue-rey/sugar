# Optional overrides for compose.yaml. Copy to .env before starting if needed.
APP_PORT=8088
DB_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=admin@local
# Set a password here before first boot, or read the generated password in `docker compose logs api`.
ADMIN_PASSWORD=
# Optional. When empty, a stable random signing secret is stored in PostgreSQL.
JWT_SECRET=
# Optional GitHub App installation. Use literal \n between private-key lines.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
