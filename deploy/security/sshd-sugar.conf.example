# Template only: verify an independent operator key + provider console BEFORE applying.
# Check the effective configuration with sshd -T: OpenSSH uses the first value.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin prohibit-password
PermitUserEnvironment no
MaxAuthTries 3
LoginGraceTime 30
MaxStartups 10:30:30
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

# Optional dedicated deployment identity. Existing root forced keys remain compatible.
Match User sugar-deploy
    AuthenticationMethods publickey
    DisableForwarding yes
    PermitTTY no
Match all
